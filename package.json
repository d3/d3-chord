{
  "name": "d3-chord",
  "version": "3.0.2",
  "description": "Visualize relationships or network flow with an aesthetically-pleasing circular layout.",
  "homepage": "https://d3js.org/d3-chord/",
  "repository": {
    "type": "git",
    "url": "https://github.com/d3/d3-chord.git"
  },
  "keywords": [
    "d3",
    "d3-module",
    "chord",
    "radial",
    "network",
    "flow"
  ],
  "license": "ISC",
  "author": {
    "name": "Mike Bostock",
    "url": "http://bost.ocks.org/mike"
  },
  "type": "module",
  "files": [
    "dist/**/*.js",
    "dist/**/*.mjs"
  ],
  "module": "dist/d3-chord.mjs",
  "main": "dist/d3-chord.mjs",
  "jsdelivr": "dist/d3-chord.min.js",
  "unpkg": "dist/d3-chord.min.js",
  "exports": {
    "umd": "./dist/d3-chord.min.js",
    "default": "./dist/d3-chord.mjs"
  },
  "sideEffects": false,
  "dependencies": {
    "d3-path": "1 - 3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "rollup": "^4.67.4",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest",
    "lint": "eslint",
    "prepublishOnly": "rm -rf dist && rollup -c"
  },
  "engines": {
    "node": ">=12"
  }
}
